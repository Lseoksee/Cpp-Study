{
    "tasks": [
        {
            "type": "shell",
            "label": "Build G++",
            "command": "g++",
            // 컴파일 옵션
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-pedantic-errors",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}/bin/${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build EXE"
        }
    ],
    "version": "2.0.0"
}
